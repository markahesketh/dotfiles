{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree",
      "ShareOnboardingGuide",
      "AskUserQuestion"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "research": "off",
    "codebase-design": "off"
  },
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/markhesketh/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/route-commit-to-skill.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": true
  },

  "disableSideloadFlags": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false,
  "theme": "light",
  "verbose": false,
  "autoCompactEnabled": true,
  "disableDeepLinkRegistration": "disable"
}
