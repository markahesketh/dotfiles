{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree",
      "ShareOnboardingGuide",
      "AskUserQuestion"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/route-to-skill.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/load-direnv.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "claude-api@anthropic-agent-skills": true,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gcx@gcx-marketplace": true,
    "pstack@pstack-claude": true,
    "ruby-lsp@claude-plugins-official": false,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "gcx-marketplace": {
      "source": {
        "source": "github",
        "repo": "grafana/gcx"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "disableSideloadFlags": true,
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 300000,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false,
  "theme": "light",
  "verbose": false,
  "autoCompactEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(kamal app restart *)",
      "Bash(kamal app stop *)",
      "Bash(kamal deploy *)"
    ]
  },
  "disableDeepLinkRegistration": "disable"
}
