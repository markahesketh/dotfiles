#!/bin/bash

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPODIR="$(cd "${BASEDIR}/.." && pwd)"

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
command_exists() {
	command -v "$@" > /dev/null 2>&1
}

# ------------------------------------------------------------------------------
# Setup dotfiles
# ------------------------------------------------------------------------------
source "${BASEDIR}/dotfiles"

DOCKER_COMPLETION_URL="https://raw.githubusercontent.com/docker/cli/master/contrib/completion/zsh/_docker"
DOCKER_COMPLETION_DIR="$HOME/.zsh/completions"
DOCKER_COMPLETION_FILE="$DOCKER_COMPLETION_DIR/_docker"
if [ ! -f "$DOCKER_COMPLETION_FILE" ]; then
    echo "Downloading Docker autocomplete"
    mkdir -p "$DOCKER_COMPLETION_DIR"
    if [ -f "$HOME/.docker-completion.zsh" ]; then
        cp "$HOME/.docker-completion.zsh" "$DOCKER_COMPLETION_FILE"
    elif command_exists curl; then
        curl -fL -o "$DOCKER_COMPLETION_FILE" "$DOCKER_COMPLETION_URL"
    elif command_exists wget; then
        wget -O "$DOCKER_COMPLETION_FILE" "$DOCKER_COMPLETION_URL"
    else
        echo "Warning: neither curl nor wget is installed; Docker autocomplete was skipped."
    fi
    echo ""
else
    echo "Docker autocomplete already installed, skipping."
fi

if [[ "$(uname)" != "Darwin" ]] && ! command_exists atuin; then
    echo "Installing Atuin"
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
    echo ""
fi

if [[ "$(uname)" == "Darwin" ]]; then
    echo "Installing Homebrew packages"
    brew bundle --file="${REPODIR}/Brewfile"
    echo ""
fi

if [[ "$(uname)" == "Darwin" ]]; then
    source "${REPODIR}/bin/setup_macos"
fi

# ------------------------------------------------------------------------------
# Finish
# ------------------------------------------------------------------------------
echo "Installation complete!"
exec $SHELL -l
